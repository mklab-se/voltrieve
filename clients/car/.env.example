# Build-time configuration. No secrets: these are public identifiers.
VITE_API_URL=https://<web-api>.azurecontainerapps.io
VITE_ENTRA_TENANT_ID=<tenant id>
VITE_ENTRA_CLIENT_ID=<voltrieve-car client id>
VITE_API_SCOPE=api://<voltrieve-api client id>/access_as_user
# The switch for remote control in the menu. Only with the car door in the API.
VITE_REMOTE_CONTROL=false
